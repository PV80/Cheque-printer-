{
  "name": "cheque-printer",
  "productName": "Cheque Printer",
  "description": "Offline cheque printing from signed requisition PDFs",
  "author": "Cheque Printer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && node scripts/copy-pdfjs-assets.mjs && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.21.5",
    "lucide-react": "^0.363.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.2.67",
    "playwright-core": "^1.65.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.chequeprinter.app",
    "productName": "Cheque Printer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Cheque Printer",
      "artifactName": "Cheque-Printer-Setup-${version}.exe"
    }
  }
}
